# Local agent tooling state — never part of the public repo.
.headroom/
.serena/
# #1321: lane copies live in `.worktrees/` INSIDE the working tree, and a fresh
# clone has no `.git/info/exclude` entry for them — without this line the new
# `scripts/new-lane.sh` would itself make the tree dirty, and `scripts/mutate.sh`
# refuses to run on a dirty tree. Same reason as `/.mutations/` below.
/.worktrees/
# #1221: the mutation-run trail is machine-local too — scripts/mutate.sh refuses
# to run on a dirty tree, so its own record must not make the tree dirty.
/.mutations/
# spec-26 T5: the Firebase config with the project keys is local-only — the
# shared Firestore layer is absent without it and the app works as before.
google-services.json
.audit/
.freebuff/
.superpowers/
.kilo/
.mimosa/
/.scratch/
/.phone-screen*.png
/web/.wrangler/

# spec-19 T3: the ONNX embedding model + its 250k-piece tokenizer are
# fetched at build time by the `downloadE5Model` Gradle task (118 MB int8
# model — over GitHub's 100 MB file limit), never committed. The tokenizer
# unit tests use an inline mini fixture; the real tokenizer only loads
# together with the model at runtime / in the eval gate.
/app/src/main/assets/models/e5/
# The pinned TDLib AAR is fetched by downloadTdlib and must never be committed.
/app/libs/tdlib-*

# Stray JVM/Robolectric test reports dumped in the repo root (#269).
/TEST-*.xml

# Local binary scratch dir (#269).
/binary/

# rules-matrix harness
scripts/rules-matrix/node_modules/
scripts/rules-matrix/firestore.rules
scripts/rules-matrix/results-*.json
scripts/rules-matrix/*-debug.log

# робочі теки сварму (логи, промпти, TMPDIR) — не вміст репозиторію
/.cache-tmp/

# scripts/run.sh пише логи й коди сюди (типовий шлях — .run/<імʼя>.log
# від поточного каталогу). Це артефакти прогону, не джерело.
.run/
