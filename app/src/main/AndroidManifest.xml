<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Shake-to-extend haptic feedback (ShakeDetector). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Background playback (audit PERF-002): foreground service hosting the
         MediaSession, plus the runtime notification permission on 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <attribution android:tag="audioPlayer" android:label="@string/app_name" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MyApplication">
        <!-- #411: reports stay only on-device until the listener explicitly
             opts in after a crash. The runtime consent controller is the only
             code allowed to override this default. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- MediaSessionService: hosts the MediaSession around the shared
             app-scoped player; keeps playback alive in the background and
             shows the media notification with transport controls. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Routes hardware media buttons (Bluetooth/wired headset keys) to
             the MediaSession in PlaybackService. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- ADR-0024 (#362): Cast framework reads its options (Default Media
             Receiver) from this provider; the receiver plays from the phone's
             Playback Proxy, never from the internet. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.slukhayka.audiobooks.player.CastOptionsProvider" />

        <!-- #393: Foreground service for ongoing download notification. -->
        <service
            android:name=".data.downloads.DownloadNotificationService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Jetpack Glance Home Screen Widget (spec-21 Track B, restored as
             spec-22 T4): cover, title/chapter, progress, play/pause, ±15 s. -->
        <receiver
            android:name=".widget.AudiobookGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/audiobook_widget_info" />
        </receiver>
    </application>
</manifest>
