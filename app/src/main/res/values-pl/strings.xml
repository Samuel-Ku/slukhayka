<resources>
    <!-- POLISH — the Material3 overrides, in the app's own accent language.

         HISTORY. This file started as a UKRAINIAN override (#371): while the
         app UI was Ukrainian, Android would otherwise voice Material3's own
         Polish strings ("Zamknij arkusz", "Uchwyt do przeciągania") through
         TalkBack on a Polish device, mixing two languages in the ear. A `pl`
         qualifier holding Ukrainian text won over the library's Polish.

         #1385/#1387–#1389 changed the premise: the app itself is now fully
         translated into Polish (`strings_app.xml`, `strings_rest.xml`), the
         language switch is ON, and a Polish device resolves the `pl` qualifier
         everywhere. A Ukrainian override HERE would now be the exact defect it
         was invented to prevent — Polish UI with Ukrainian bottom-sheet
         announcements.

         So the file keeps its purpose (match the library's own phrasing, not
         a machine translation of our own) but flips its language: the values
         are the same Polish sentences Compose Material3 1.3.2 ships in
         `material3-release.aar`, kept in sync by
         `scripts/tests/test_polish_locale.py` (which fails on Cyrillic here and
         on a drifted/extra override). App-owned strings never belong in this
         file: they live in `strings_app.xml` and `strings_rest.xml`, and a key
         may be defined in exactly one file of the `pl` qualifier. -->
    <string name="m3c_bottom_sheet_collapse_description">Zwiń planszę dolną</string>
    <string name="m3c_bottom_sheet_dismiss_description">Zamknij planszę dolną</string>
    <string name="m3c_bottom_sheet_drag_handle_description">Uchwyt do przeciągania</string>
    <string name="m3c_bottom_sheet_expand_description">Rozwiń planszę dolną</string>
    <string name="m3c_bottom_sheet_pane_title">Plansza dolna</string>
    <!-- Plan 2026-2027: the appearance group on the Settings root. -->
    <string name="settings_group_appearance">Wygląd</string>
    <string name="settings_theme">Motyw</string>
    <string name="settings_theme_auto">Auto</string>
    <string name="settings_theme_paper">Papier</string>
    <string name="settings_theme_ink">Atrament</string>
    <string name="settings_player_always_ink">Odtwarzacz zawsze ciemny</string>
    <string name="settings_player_always_ink_desc">Odtwarzacz pozostaje w motywie Atrament, nawet gdy aplikacja jest jasna.</string>
</resources>
