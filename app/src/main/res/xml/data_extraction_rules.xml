<?xml version="1.0" encoding="utf-8"?><!--
    Spec-40 #276 (t2) — data extraction rules (API 31+): the same durable
    set as backup_rules.xml, for both cloud backups and device transfers.
    The listener identity's generated credentials (`listener_identity`) are
    the point of the exercise: a fresh install restores them and silently
    signs back into the same account.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="listener_identity.xml"/>
        <include domain="database" path="read4_audiobook_database"/>
        <include domain="database" path="read4_audiobook_database-wal"/>
        <include domain="database" path="read4_audiobook_database-shm"/>
        <include domain="sharedpref" path="listen_prefs.xml"/>
        <include domain="sharedpref" path="network_privacy_settings.xml"/>
        <include domain="sharedpref" path="playback_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="listener_identity.xml"/>
        <include domain="database" path="read4_audiobook_database"/>
        <include domain="database" path="read4_audiobook_database-wal"/>
        <include domain="database" path="read4_audiobook_database-shm"/>
        <include domain="sharedpref" path="listen_prefs.xml"/>
        <include domain="sharedpref" path="network_privacy_settings.xml"/>
        <include domain="sharedpref" path="playback_settings.xml"/>
    </device-transfer>
</data-extraction-rules>
