rules_version = '2';

// Spec-30 T1 (#216) + spec-32 T1 (#231) + spec-33 T1 (#229) — access
// hardening for the shared book-metadata base.
//
// The base holds ANONYMOUS crowd facts — universe resolutions
// (`universe_resolutions`, spec-26), book durations (`book_durations`,
// spec-30), full book profiles (`book_profiles`, spec-32) and merged search
// results (`search_results`, spec-33) — with no personal data, so reads are
// public by design: any listener may consult the cache, exactly as the
// degrade-never client expects. Writes are the only attack surface and are
// limited to App Check-validated installs of the Слухайка app.
//
// Two layers gate the writes:
//  1. App Check enforcement is ALSO enabled per service in the Firebase
//     console (App Check → Firestore → Enforce). That layer rejects requests
//     without a valid App Check token BEFORE these rules run — the primary
//     verifier (the rules language only sees the token, it cannot verify it).
//  2. The rules below are the defense-in-depth gate: a request that carries
//     no App Check token at all is denied here regardless of the console
//     setting. The client SDK attaches a token once App Check is installed
//     (App.installAppCheckIfConfigured); until then the app's own writes
//     degrade silently (best-effort fire-and-forget, never a crash).
//
// Deploy: `firebase deploy --only firestore` (or the console Rules tab).
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the request carries an App Check token (defense in depth —
    // signature verification happens at the enforcement layer above).
    function isAppCheckValid() {
      return request.appCheck.token != null;
    }

    // Spec-40 #277 — the shape gate for one listener review: identity fields
    // real and bounded, rating exactly 1..5, optional strings within their
    // limits when present, timestamps numeric. Mirrors the client codec's
    // bounds so a document the rules accept is one the app can decode.
    function isWellFormedReview(d) {
      return d.workId is string && d.workId.size() > 0 && d.workId.size() <= 300
        && d.uid is string && d.uid.size() > 0
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 100
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.createdAt is number
        && (!('body' in d) || (d.body is string && d.body.size() <= 2000))
        && (!('editionTag' in d) || (d.editionTag is string && d.editionTag.size() <= 200))
        && (!('editedAt' in d) || d.editedAt is number);
    }

    // Spec-42 #303 — one canonical duration is a small anonymous fact. The
    // duration bounds mirror DurationSanity and provenance is both required
    // and bounded. hasOnly keeps personal or unrecognised fields out of this
    // public collection.
    function isPlausibleDurationSeconds(value) {
      return value is int
        && value > 0
        && value != 14400
        && value <= 360000;
    }

    function isDurationIdentityComponent(value, maxSize) {
      return value is string
        && value.size() > 0
        && value.size() <= maxSize
        && value.matches('^[A-Za-z0-9._-]+$');
    }

    function isBoundedDurationProvenance(d, timeField) {
      return d.source is string
        && d.source.size() > 0
        && d.source.size() <= 100
        && isDurationIdentityComponent(d.method, 100)
        && timeField is int
        && timeField >= 0;
    }

    function isWellFormedDuration(d) {
      return d.keys().hasOnly(['durationSeconds', 'source', 'method', 'derivedAt'])
        && isPlausibleDurationSeconds(d.durationSeconds)
        && isBoundedDurationProvenance(d, d.derivedAt);
    }

    function isWellFormedDurationConflict(d) {
      return d.keys().hasOnly(['editionId', 'candidateSeconds', 'source', 'method', 'observedAt'])
        && isDurationIdentityComponent(d.editionId, 300)
        && isPlausibleDurationSeconds(d.candidateSeconds)
        && isBoundedDurationProvenance(d, d.observedAt);
    }

    // Spec-42 #311 — one compact assertion is EITHER Work bibliographic
    // facts OR Edition rendition facts. The mutually exclusive hasOnly sets
    // prevent narrator/duration from leaking onto Work and keep personal or
    // playback fields out of the shared delta base.
    function isFacetId(value, maxSize) {
      return value.size() <= maxSize
        && value.matches('^[^/~]*[^\\s/~][^/~]*$');
    }

    function isFacetPerson(value) {
      return value.keys().hasOnly(['id', 'name', 'aliases'])
        && isFacetId(value.id, 250)
        && value.name.size() <= 200
        && value.name.matches('.*\\S.*')
        && isFacetAliasList(value.aliases);
    }

    // Rules have no list `all` operator, so the bounded positions are
    // checked explicitly. Short-circuiting keeps indexes past size unread.
    function isFacetAliasList(v) {
      return v is list && v.size() <= 8
        && v.toSet().size() == v.size()
        && (v.size() < 1 || (v[0].matches('^.{1,200}$') && v[0].matches('.*\\S.*')))
        && (v.size() < 2 || (v[1].matches('^.{1,200}$') && v[1].matches('.*\\S.*')))
        && (v.size() < 3 || (v[2].matches('^.{1,200}$') && v[2].matches('.*\\S.*')))
        && (v.size() < 4 || (v[3].matches('^.{1,200}$') && v[3].matches('.*\\S.*')))
        && (v.size() < 5 || (v[4].matches('^.{1,200}$') && v[4].matches('.*\\S.*')))
        && (v.size() < 6 || (v[5].matches('^.{1,200}$') && v[5].matches('.*\\S.*')))
        && (v.size() < 7 || (v[6].matches('^.{1,200}$') && v[6].matches('.*\\S.*')))
        && (v.size() < 8 || (v[7].matches('^.{1,200}$') && v[7].matches('.*\\S.*')));
    }

    function isFacetGenre(value) {
      return value.keys().hasOnly(['id', 'rawText'])
        && isFacetId(value.id, 250)
        && value.rawText.matches('^.{1,200}$')
        && value.rawText.matches('.*\\S.*');
    }

    function isFacetGenreList(v) {
      return v is list && v.size() <= 4
        && (v.size() < 1 || isFacetGenre(v[0]))
        && (v.size() < 2 || isFacetGenre(v[1]))
        && (v.size() < 3 || isFacetGenre(v[2]))
        && (v.size() < 4 || isFacetGenre(v[3]))
        && (v.size() < 2 || v[0].id != v[1].id)
        && (v.size() < 3 || (v[0].id != v[2].id && v[1].id != v[2].id))
        && (v.size() < 4 || (v[0].id != v[3].id
          && v[1].id != v[3].id && v[2].id != v[3].id));
    }

    function isFacetSeriesMembership(value) {
      return value.keys().hasOnly(['seriesId', 'position'])
        && isFacetId(value.seriesId, 250)
        && (!('position' in value) || (value.position is int
          && value.position > 0 && value.position <= 10000));
    }

    function isFacetSeriesList(value) {
      return value is list && value.size() <= 4
        && (value.size() < 1 || isFacetSeriesMembership(value[0]))
        && (value.size() < 2 || isFacetSeriesMembership(value[1]))
        && (value.size() < 3 || isFacetSeriesMembership(value[2]))
        && (value.size() < 4 || isFacetSeriesMembership(value[3]))
        && (value.size() < 2 || value[0].seriesId != value[1].seriesId)
        && (value.size() < 3 || (value[0].seriesId != value[2].seriesId
          && value[1].seriesId != value[2].seriesId))
        && (value.size() < 4 || (value[0].seriesId != value[3].seriesId
          && value[1].seriesId != value[3].seriesId
          && value[2].seriesId != value[3].seriesId));
    }

    function isFacetBase(d, document, kind) {
      return d.schemaVersion is int && d.schemaVersion == 1
        && d.assertionId == document
        && d.entityKind == kind
        && isFacetId(d.entityId, 250)
        && isFacetId(d.sourceId, 50)
        && d.observedAt is int && d.observedAt >= 0
        && d.updatedAt is int && d.updatedAt >= 0
        // Five minutes absorbs honest client clock skew but prevents a valid
        // App Check client from freezing this source-owned assertion forever.
        && d.updatedAt <= request.time.toMillis() + 300000
        && document == kind + '~' + d.entityId + '~' + d.sourceId;
    }

    function isWellFormedWorkFacet(d, document) {
      return d.keys().hasOnly([
          'schemaVersion', 'assertionId', 'entityKind', 'entityId',
          'sourceId', 'observedAt', 'updatedAt', 'author', 'genres',
          'seriesMemberships'
        ])
        && isFacetBase(d, document, 'work')
        && d.keys().size() > 7
        && (!('author' in d) || isFacetPerson(d.author))
        && (!('genres' in d) || (d.genres.size() > 0
          && isFacetGenreList(d.genres)))
        && (!('seriesMemberships' in d) || (d.seriesMemberships.size() > 0
          && isFacetSeriesList(d.seriesMemberships)));
    }

    function hasCompleteFacetAvailability(d) {
      return (!('availabilityAvailable' in d)
          && !('availabilityObservedAt' in d)
          && !('availabilityTtlSeconds' in d))
        || (d.availabilityAvailable is bool
          && d.availabilityObservedAt is int
          && d.availabilityObservedAt >= 0
          && d.availabilityTtlSeconds is int
          && d.availabilityTtlSeconds > 0
          && d.availabilityTtlSeconds <= 2592000);
    }

    function hasValidDurationFacetReference(d) {
      return (!('durationRef' in d) && !('durationBucket' in d))
        || (d.durationRef == d.entityId
          && d.durationBucket in ['under_5h', '5h_to_10h', '10h_to_20h', '20h_plus']);
    }

    function isWellFormedEditionFacet(d, document) {
      return d.keys().hasOnly([
          'schemaVersion', 'assertionId', 'entityKind', 'entityId',
          'sourceId', 'observedAt', 'updatedAt', 'workId', 'narrator',
          'language', 'durationRef', 'durationBucket', 'chapterCount',
          'completeness', 'availabilityAvailable',
          'availabilityObservedAt', 'availabilityTtlSeconds'
        ])
        && isFacetBase(d, document, 'edition')
        && isFacetId(d.workId, 250)
        && d.keys().size() > 8
        && (!('narrator' in d) || isFacetPerson(d.narrator))
        && (!('language' in d) || (d.language is string
          && d.language.size() > 0 && d.language.size() <= 20
          && d.language.matches('^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$')))
        && hasValidDurationFacetReference(d)
        && (!('chapterCount' in d) || (d.chapterCount is int
          && d.chapterCount > 0 && d.chapterCount <= 500))
        && (!('completeness' in d) || d.completeness in ['full', 'abridged'])
        && hasCompleteFacetAvailability(d);
    }

    function isWellFormedFacet(d, document) {
      return isWellFormedWorkFacet(d, document)
        || isWellFormedEditionFacet(d, document);
    }

    function facetIdentityIsImmutable(before, after) {
      return before.assertionId == after.assertionId
        && before.entityKind == after.entityKind
        && before.entityId == after.entityId
        && before.sourceId == after.sourceId
        && (!('workId' in before) || before.workId == after.workId);
    }

    // Spec-40 #277 — listener reviews of a Work: readable by everyone (the
    // block renders on every book page), writable only by the review's own
    // author under App Check. The document key is `${workId}_${uid}` but the
    // FIELD uid is the ownership anchor: create/update require the payload's
    // uid to be the caller's; delete requires the stored row's uid to be.
    match /book_reviews/{document} {
      allow read: if true;
      allow create: if isAppCheckValid()
        && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isWellFormedReview(request.resource.data);
      allow update: if isAppCheckValid()
        && request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && isWellFormedReview(request.resource.data);
      allow delete: if isAppCheckValid()
        && request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ADR-0023 (#348) — the shape gate for one narration rating: identity
    // fields real and bounded, rating exactly 1..5, timestamps numeric.
    // Mirrors the client codec's bounds so a document the rules accept is
    // one the app can decode.
    function isWellFormedNarrationRating(d) {
      return d.workId is string && d.workId.size() > 0 && d.workId.size() <= 300
        && d.uid is string && d.uid.size() > 0
        && d.editionId is string && d.editionId.size() > 0 && d.editionId.size() <= 200
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.createdAt is number
        && (!('editedAt' in d) || d.editedAt is number);
    }

    // ADR-0023 (#348) — listener ratings of ONE Edition («Оцінка начитки»):
    // readable by everyone, writable only by the rating's own owner under
    // App Check — the exact model of book_reviews above. The document key is
    // `${workId}_${uid}_${editionId}` but the FIELD uid is the ownership
    // anchor.
    match /edition_ratings/{document} {
      allow read: if true;
      allow create: if isAppCheckValid()
        && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isWellFormedNarrationRating(request.resource.data);
      allow update: if isAppCheckValid()
        && request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && isWellFormedNarrationRating(request.resource.data);
      allow delete: if isAppCheckValid()
        && request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /universe_resolutions/{document} {
      allow read: if true;
      allow write: if isAppCheckValid();
    }

    match /book_durations/{document} {
      allow read: if true;
      allow create: if isAppCheckValid()
        && isDurationIdentityComponent(document, 300)
        && isWellFormedDuration(request.resource.data);
      // Ordinary clients are create-only. Firebase Admin SDK bypasses rules
      // and remains the deliberately privileged correction path.
      allow update, delete: if false;
    }

    // Spec-42 #303 — one idempotent disagreement record per deterministic
    // Edition/value/method key. It contains no account or device identity.
    match /book_duration_conflicts/{document} {
      allow read: if true;
      allow create: if isAppCheckValid()
        && isWellFormedDurationConflict(request.resource.data)
        && document == request.resource.data.editionId
          + '|' + string(request.resource.data.candidateSeconds)
          + '|' + request.resource.data.method;
      allow update, delete: if false;
    }

    match /book_facets/{document} {
      allow read: if true;
      allow create: if isAppCheckValid()
        && isWellFormedFacet(request.resource.data, document);
      allow update: if isAppCheckValid()
        && facetIdentityIsImmutable(resource.data, request.resource.data)
        && request.resource.data.updatedAt > resource.data.updatedAt
        && isWellFormedFacet(request.resource.data, document);
      allow delete: if false;
    }

    match /book_profiles/{document} {
      allow read: if true;
      allow write: if isAppCheckValid();
    }

    match /search_results/{document} {
      allow read: if true;
      allow write: if isAppCheckValid();
    }

    // Spec-40 #276 (t2) — the silent same-phone restore. One document per
    // device (`{ANDROID_ID} → { uid, cred }`), written only by the owner of
    // that uid. Reads are public BY DESIGN: the fresh-install lookup happens
    // before any auth exists. The `cred` payload is sealed client-side with
    // a key derived from the device's ANDROID_ID (DeviceBindingCipher), so
    // the publicly readable document yields usable credentials on THIS
    // phone alone; another reader gets opaque bytes and a pseudonymous uid.
    match /device_bindings/{deviceId} {
      allow read: if true;
      allow write: if isAppCheckValid()
        && request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.uid is string;
    }

    // ADR-0023 (spec-43 T6) — Progress Sync: one Listening State mirror per
    // listener per Edition (`{uid}_{editionId}`), readable and writable ONLY
    // by its own listener under App Check. The FIELD uid is the ownership
    // anchor (the rules language cannot see the document id). The shape gate
    // mirrors ProgressSyncCodec's bounds; `updatedAt` must be a server
    // timestamp, so a client can never forge the LWW ordering clock.
    function isWellFormedListeningState(d) {
      return d.editionId is string && d.editionId.size() > 0 && d.editionId.size() <= 300
        && d.uid is string && d.uid.size() > 0
        && d.chapterIndex is int && d.chapterIndex >= 0
        && d.positionSeconds is number && d.positionSeconds >= 0 && d.positionSeconds < 86400000
        && d.isCompleted is bool
        && (!('preferredSpeed' in d) || (d.preferredSpeed is number && d.preferredSpeed >= 0.25 && d.preferredSpeed <= 4.0))
        && d.updatedAt == request.time;
    }

    match /listening_state/{document} {
      allow read: if isAppCheckValid()
        && request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if isAppCheckValid()
        && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isWellFormedListeningState(request.resource.data);
      allow update: if isAppCheckValid()
        && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && resource.data.uid == request.auth.uid
        && isWellFormedListeningState(request.resource.data);
      allow delete: if false;
    }
  }
}
